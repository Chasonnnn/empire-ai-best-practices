# Merge into existing config; replace USER with the actual Empire username.
# Historical Alpha password/MFA route; preserve newer approved host policy.
Host empire alpha.empire-ai.org
  HostName alpha.empire-ai.org
  User USER
  PubkeyAuthentication no
  PreferredAuthentications keyboard-interactive,password
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  # Idle persistence with no clients, not elapsed authentication lifetime.
  # Server/network conditions can end the connection earlier.
  ControlPersist 48h
  ServerAliveInterval 60
  ServerAliveCountMax 5

# Automation alias (2026-10-07). Rides the same master socket as `empire`; never opens a connection itself.
# ProxyCommand runs only when no master socket answers, and /usr/bin/false makes that attempt fail at once,
# so a dead socket cannot fall through to password attempts that get the source IP blocked.
# Agents use `ssh empire-batch ...`, `rsync ... empire-batch:path`, `scp ... empire-batch:path`.
Host empire-batch
  HostName alpha.empire-ai.org
  User USER
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlMaster no
  BatchMode yes
  ProxyCommand /usr/bin/false
