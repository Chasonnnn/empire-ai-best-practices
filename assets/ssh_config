# Merge into existing config; replace USER with the actual Empire username.
# Historical Alpha password/MFA route; preserve newer approved host policy.
Host empire alpha.empire-ai.org
  HostName alpha.empire-ai.org
  User USER
  PubkeyAuthentication no
  PreferredAuthentications keyboard-interactive,password
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  # Idle persistence with no clients, not elapsed authentication lifetime.
  # Server/network conditions can end the connection earlier.
  ControlPersist 48h
  ServerAliveInterval 60
  ServerAliveCountMax 5
